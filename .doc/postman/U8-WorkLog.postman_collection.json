      "name": "01 นักศึกษาบันทึก แนบไฟล์ และส่งบันทึก",
      "item": [
        {
          "name": "01-1 หาการฝึกงานของตนเอง (GET /api/internships/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{studentA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/internships/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "internships",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('IN_PROGRESS', () => pm.expect(pm.response.json().status).to.eql('IN_PROGRESS'));",
                  "pm.collectionVariables.set('internshipId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "01-2 สรุปบันทึก + เลือกวันที่ยังไม่บันทึก (GET summary)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{studentA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/internships/{{internshipId}}/work-logs/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "internships",
                "{{internshipId}}",
                "work-logs",
                "summary"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test('มี totalHours / workingDays / missingDates', () => { pm.expect(s).to.have.property('totalHours'); pm.expect(s.missingDates).to.be.an('array'); });",
                  "// ใช้วันทำงานที่ยังไม่มีบันทึกเป็นวันที่ทดสอบ (รันซ้ำได้)",
                  "pm.collectionVariables.set('logDate', s.missingDates.length ? s.missingDates[s.missingDates.length - 1] : new Date().toISOString().slice(0, 10));",
                  "const d = new Date(); d.setDate(d.getDate() + 1); pm.collectionVariables.set('tomorrow', d.toISOString().slice(0, 10));"
                ]
              }
            }
          ]
        },
